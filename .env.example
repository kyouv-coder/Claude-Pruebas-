DATABASE_URL="postgresql://spa_user:spa_password@localhost:5432/spa_reservas?schema=public"

# Login del panel de administración
# Generá un valor aleatorio largo, por ejemplo: openssl rand -base64 32
AUTH_SECRET="genera-un-valor-aleatorio-largo"

# Aviso diario de reservas (Resend + Vercel Cron)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="reservas@tudominio.com"
ADMIN_EMAIL="administracion@tuspa.com"
CRON_SECRET="genera-un-valor-aleatorio-largo"

# Opcional: credenciales del admin creado por npm run db:seed
# (si no se definen, usa admin@spa.local / changeme123)
SEED_ADMIN_EMAIL="admin@spa.local"
SEED_ADMIN_PASSWORD="changeme123"
